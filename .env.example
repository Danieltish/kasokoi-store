# --- Database (Supabase) ---
# Supabase Connect > ORM > Prisma gives you both URLs.
#
# DATABASE_URL is used by the Prisma 7 driver adapter (@prisma/adapter-pg) at runtime.
# Use the SESSION pooler (port 5432): it supports prepared statements over IPv4.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# DIRECT_URL is used by Prisma CLI for migrations/db push. Same session pooler is fine.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Transaction pooler (port 6543) is an option for serverless production.
# It does not support prepared statements, so only enable it if the adapter is configured for it.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Public site URL (used for metadata, canonical URLs, sitemap and links).
NEXT_PUBLIC_SITE_URL="https://kasokoi.co.ke"

# WhatsApp order number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="254717376964"

# Secret used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Store owner. Only this account can create or promote superadmins.
OWNER_EMAIL="tishtitoh@gmail.com"

# Initial superadmin created by `npm run seed` (change after first login).
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="replace-with-a-strong-password"

# --- Product image uploads (Supabase Storage) ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL="https://<project-ref>.supabase.co"

# Server-only secret key (Project Settings > API Keys > secret key).
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-secret-key"

# Public bucket used for product images. Created automatically on first upload.
SUPABASE_STORAGE_BUCKET="product-images"
